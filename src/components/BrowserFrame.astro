---
type Props = {
  class?: string;
  title: string;
  url: string;
  width?: number;
  height?: number;
};

const {
  class: className = "",
  title,
  url,
  width = 1440,
  height = Math.round(width * 0.62),
} = Astro.props as Props;
---

<div class:list={["case-study-browser-frame", className]}>
  <div class="case-study-browser-frame-toolbar">
    <span class="case-study-browser-frame-dot case-study-browser-frame-dot--red"
    ></span>
    <span
      class="case-study-browser-frame-dot case-study-browser-frame-dot--yellow"
    ></span>
    <span
      class="case-study-browser-frame-dot case-study-browser-frame-dot--green"
    ></span>
    <span class="case-study-browser-frame-address">{title}</span>
  </div>
  <div
    class="case-study-browser-frame-viewport"
    data-frame-width={width}
    style={`aspect-ratio: ${width} / ${height};`}
  >
    <iframe
      class="case-study-browser-frame-embed"
      src={url}
      title={title}
      loading="lazy"
      width={width}
      height={height}></iframe>
  </div>
</div>

<script>
  function scaleBrowserFrame(viewport: HTMLElement) {
    const iframe = viewport.querySelector<HTMLIFrameElement>(
      ".case-study-browser-frame-embed",
    );
    const frameWidth = Number(viewport.dataset.frameWidth);
    if (!iframe || !frameWidth) return;

    const resize = () => {
      const scale = viewport.clientWidth / frameWidth;
      iframe.style.transform = `scale(${scale})`;
    };

    new ResizeObserver(resize).observe(viewport);
    resize();
  }

  document
    .querySelectorAll<HTMLElement>(".case-study-browser-frame-viewport")
    .forEach(scaleBrowserFrame);
</script>
